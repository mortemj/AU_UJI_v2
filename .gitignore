# =============================================================================
# .gitignore — TFM AU_UJI v2
# Autora: María José Morte
# Última actualización: 10/05/2026 (v3 — fusión con manual de inicio + DEMO)
#
# Filosofía v3: REPRODUCIBILIDAD TOTAL + DEMO PÚBLICO
# - Se suben TODOS los modelos (.pkl comprimidos con joblib compress=3)
# - Se suben los datos de train/test y el pipeline de preprocesamiento
# - Se suben los resultados de Fase 5 y Fase 6 (sistema dinámico los usa)
# - Se ignoran los datos originales (privacidad UJI) y los intermedios
#   (se regeneran ejecutando las fases 1-3)
# - Se suben las carpetas data/ vacías con .gitkeep (estructura visible)
# - Se sube data/demo/ con un Excel de prueba para reproducir sin datos reales
# =============================================================================


# -----------------------------------------------------------------------------
# DATOS — qué se sube y qué no
# -----------------------------------------------------------------------------

# Datos originales: NO subir (privacidad UJI, contiene PII de alumnos)
data/00_raw/*
!data/00_raw/.gitkeep

# Datos intermedios: NO subir contenido (se regeneran ejecutando las fases 1-3)
# Pero SÍ subir las carpetas vacías para que la estructura sea visible en GitHub.
data/01_interim/*
!data/01_interim/.gitkeep

data/01_raw/*
!data/01_raw/.gitkeep

data/02_processed/*
!data/02_processed/.gitkeep

data/03_features/*
!data/03_features/.gitkeep

data/04_eda/*
!data/04_eda/.gitkeep

data/06_interpretacion/*
!data/06_interpretacion/.gitkeep

data/07_aplicacion/*
!data/07_aplicacion/.gitkeep

# AutoML: NO subir contenido (cientos de MB, no es el modelado final del TFM)
data/automl/*
!data/automl/.gitkeep

# Resultados Fase 5 dentro de data/: NO subir (parquet enorme)
data/05_modelado/results/*
!data/05_modelado/results/.gitkeep

# Modelos Fase 5: SÍ se suben TODOS (comprimidos con joblib compress=3)
# Total: 266.8 MB (15 grandes comprimidos + 54 pequeños sin comprimir)
# Permite reproducibilidad total y selección dinámica del ganador.
# (Sin regla de exclusión — todos los .pkl de models/ entran al repo)

# DEMO: SÍ subir (Excel de prueba con 50 alumnos para reproducir sin datos reales)
# data/demo/ se sube íntegra (zip + README)

# Backups generados por f0_setup_demo.ipynb (renombrados con fecha/hora): NO subir
data/00_raw/*_BACKUP_*

# Backups temporales del script de compresión: NO subir
*.pkl.bak


# -----------------------------------------------------------------------------
# CATBOOST — artifacts automáticos del entrenamiento
# -----------------------------------------------------------------------------

# CatBoost crea estas carpetas al entrenar (logs, métricas internas).
# Se regeneran en cada ejecución, no aportan al proyecto.
catboost_info/
**/catboost_info/


# -----------------------------------------------------------------------------
# ANACONDA — caché Anaconda Navigator
# -----------------------------------------------------------------------------

# Se regenera al usar Anaconda Navigator. Nunca debe ir al repo.
anaconda_projects/


# -----------------------------------------------------------------------------
# OUTPUTS LOCALES DE INSPECCIÓN — no van al repo
# -----------------------------------------------------------------------------

# Output de `dir /S /B > tree_proyexto.txt` (uso local para chats de contexto)
tree_proyexto.txt

# Listados de árbol generados localmente (data.txt, tree.txt, estructura.txt...)
data/data.txt
data/*.txt

# Carpeta de outputs para conversaciones con asistentes IA (no va al repo)
output_para_claude/


# -----------------------------------------------------------------------------
# BACKUPS PERSONALES DE TRABAJO
# -----------------------------------------------------------------------------

# Backups personales de notebooks (no van al repo público)
*_BACKUP_*.ipynb
*_backup_*.ipynb

# .gitignore antiguo renombrado (backup local)
gitignoreOLD
.gitignore.bak.*


# -----------------------------------------------------------------------------
# PYTHON / JUPYTER
# -----------------------------------------------------------------------------

__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/


# -----------------------------------------------------------------------------
# ENTORNOS VIRTUALES
# -----------------------------------------------------------------------------

venv/
env/
.venv/
ENV/


# -----------------------------------------------------------------------------
# IDEs Y EDITORES
# -----------------------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
*~


# -----------------------------------------------------------------------------
# STREAMLIT
# -----------------------------------------------------------------------------

# Secretos de despliegue (NUNCA subir)
.streamlit/secrets.toml


# -----------------------------------------------------------------------------
# SISTEMA OPERATIVO
# -----------------------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.Trash-*


# -----------------------------------------------------------------------------
# LOGS Y TEMPORALES
# -----------------------------------------------------------------------------

*.log
*.tmp
*.temp
*.bak
*.bak.*
*.backup


# -----------------------------------------------------------------------------
# ARCHIVOS GRANDES NO RELACIONADOS CON EL TFM
# -----------------------------------------------------------------------------

# Mantener fuera del repo cualquier zip/rar/etc.
# EXCEPCIÓN: data/demo/demo_excel.zip (es el zip oficial de datos demo).
*.zip
*.rar
*.7z
*.tar
*.gz

!data/demo/demo_excel.zip


# -----------------------------------------------------------------------------
# FICHEROS HTML SUELTOS GENERADOS LOCALMENTE
# -----------------------------------------------------------------------------

# Versiones antiguas del index.html que conservas como respaldo: no subir
docs/html/index_old.html
docs/html/*_old.html
docs/html/*_OLD.html

# Backups del .docx en la raíz del repo (locales)
*~$*.docx
